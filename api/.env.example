# Local development (npm run start:dev). Docker sets these itself — see ../docker-compose.yml.
# Matches compose.dev.yml: PostgreSQL on 5433, Redis on 6380. POSTGRES_PASSWORD comes from ../.env.
DATABASE_URL=postgresql://nampani:change-me@127.0.0.1:5433/nampani
REDIS_URL=redis://127.0.0.1:6380
APP_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
CONTENT_FILE=content/studio.json
UPLOAD_DIR=uploads

# Browser notifications for staff (Web Push). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:studio@nampani.ink

# Email (Hostinger Mail). Leave SMTP_HOST empty until the mailbox exists:
# on a Mac emails are then saved to api/mail-outbox/, on the server they are skipped.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=booking@nampani.ink
SMTP_PASS=
# Sender of every email (bookings, reminders, receipts, studio alerts, staff login codes).
# Must be the same mailbox as SMTP_USER.
MAIL_FROM=Nampani Ink <booking@nampani.ink>
# Optional: a second mailbox only for booking emails (login codes then stay on MAIL_FROM).
# MAIL_BOOKING_FROM=Nampani Ink <booking@nampani.ink>
# SMTP_BOOKING_USER=booking@nampani.ink
# SMTP_BOOKING_PASS=
MAIL_STUDIO_TO=booking@nampani.ink

# Staff login needs a 6-digit code sent by email (once per device every 30 days).
# Only works when SMTP_HOST is set. Locked out (email broken)? Set to false and restart the api:
#   docker compose -f docker-compose.yml -f compose.prod.yml up -d api
LOGIN_OTP=false
POS_URL=https://pos.nampani.ink
