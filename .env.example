# Copy to .env and adjust. docker compose reads .env automatically.

# Public address of the website (no trailing slash). Set this to your real domain
# in production so canonical links, sitemap.xml and structured data are correct.
SITE_URL=http://localhost:3000

# Port on the host for the website.
WEB_PORT=3000

# PostgreSQL password (required). Use a long random value on the server.
POSTGRES_PASSWORD=change-me

# POS / Admin app origins allowed to call the API with a login cookie (comma-separated).
APP_ORIGINS=http://localhost:3000,http://localhost:3001
# Production: leave COOKIE_DOMAIN empty (cookie stays on pos.nampani.ink) and set COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Port on the host for the POS / Admin app.
APP_PORT=3001

# Browser notifications for staff (Web Push). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:studio@nampani.ink

# Email (Hostinger Mail). Leave SMTP_HOST empty until the mailbox exists:
# on a Mac emails are then saved to api/mail-outbox/, on the server they are skipped.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=studio@nampani.ink
SMTP_PASS=
MAIL_FROM=Nampani Ink <studio@nampani.ink>
MAIL_STUDIO_TO=studio@nampani.ink
POS_URL=https://pos.nampani.ink
