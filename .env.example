# Copy to .env and adjust. docker compose reads .env automatically.

# Public address of the website (no trailing slash). Set this to your real domain
# in production so canonical links, sitemap.xml and structured data are correct.
SITE_URL=http://localhost:3000

# Port on the host for the website.
WEB_PORT=3000

# PostgreSQL password (required). Use a long random value on the server.
POSTGRES_PASSWORD=change-me

# POS / Admin app origins allowed to call the API with a login cookie (comma-separated).
APP_ORIGINS=http://localhost:3000,http://localhost:3001
# Production: COOKIE_DOMAIN=.nampaniink.com and COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Port on the host for the POS / Admin app.
APP_PORT=3001
